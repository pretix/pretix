"già ricevuto gli ordini potrebbe portare a comportamenti inaspettati quando "
"si ordina o si cambia nome."

#: pretix/control/forms/event.py pretix/control/forms/organizer.py
msgid "Allowed titles"
msgstr "Titoli ammessi"

#: pretix/control/forms/event.py pretix/control/forms/organizer.py
