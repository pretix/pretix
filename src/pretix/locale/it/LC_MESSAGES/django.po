#: pretix/base/settings.py pretix/control/forms/event.py
msgid ""
"Your default locale must also be enabled for your event (see box above)."
msgstr ""
"La tua localizzazione predefinita deve essere abilitata anche per l'evento "
"(vedi riquadro sopra)."

#: pretix/base/settings.py
msgid ""
"You cannot require specifying attendee names if you do not ask for them."
msgstr ""
"Non è possibile richiedere la specificazione dei nomi dei partecipanti se "
"non li si richiede esplicitamente."

#: pretix/base/settings.py
msgid "You have to ask for attendee emails if you want to make them required."
msgstr ""
"Devi chiedere gli indirizzi e-mail dei partecipanti se vuoi renderli "
"obbligatori."

#: pretix/base/settings.py
msgid ""
"You have to ask for invoice addresses if you want to make them required."
msgstr "Devi chiedere gli indirizzi della fattura se vuoi renderli obbligatori."

#: pretix/base/settings.py
msgid "You have to require invoice addresses to require for company names."
msgstr ""
"È necessario richiedere gli indirizzi di fatturazione per i nomi delle "
"aziende."

#: pretix/base/settings.py
#, python-brace-format
msgid "VAT-ID is not supported for \"{}\"."
msgstr "L'ID IVA non è supportato per \"{}\"."

#: pretix/base/settings.py
msgid "The last payment date cannot be before the end of presale."
msgstr ""
"La data del pagamento più recente non può essere antecedente alla fine della "
"prevendita."

#: pretix/base/settings.py
#, python-brace-format
msgid "The value \"{identifier}\" is not a valid sales channel."
msgstr "Il valore \"{identifier}\" non è un canale di vendita valido."

#: pretix/base/settings.py
msgid "This needs to be disabled if other NFC-based types are active."
msgstr ""
"Questo deve essere disabilitato se sono attivi altri tipi basati su NFC."

#: pretix/base/shredder.py
msgid "Your event needs to be over to use this feature."
msgstr ""
"Il tuo evento deve essere terminato per poter utilizzare questa funzione."

#: pretix/base/shredder.py
msgid "Your ticket shop needs to be offline to use this feature."
msgstr "La tua biglietteria deve essere offline per utilizzare questa funzione."

#: pretix/base/shredder.py
msgid "Phone numbers"
msgstr "Numeri di telefono"

#: pretix/base/shredder.py
msgid "This will remove all phone numbers from orders."
msgstr "Questo eliminerà tutti i numeri di telefono dagli ordini."

#: pretix/base/shredder.py
msgid "Emails"
msgstr "Email"

#: pretix/base/shredder.py
msgid ""
"This will remove all email addresses from orders and attendees, as well as "
"logged email contents. This will also remove the association to customer "
"accounts."
msgstr ""
"Questo rimuoverà tutti gli indirizzi email dagli ordini e dai partecipanti, "
"così come il contenuto delle email registrate. Rimuoverà inoltre "
"l'associazione agli account cliente."

#: pretix/base/shredder.py
msgid ""
"This will remove all names, email addresses, and phone numbers from the "
"waiting list."
msgstr ""
"Questo eliminerà tutti i nomi, gli indirizzi e-mail e i numeri di telefono "
"dalla lista d'attesa."

#: pretix/base/shredder.py
msgid "Attendee info"
msgstr "Info partecipante"

#: pretix/base/shredder.py
msgid ""
"This will remove all attendee names and postal addresses from order "
"positions, as well as logged changes to them."
msgstr ""
"Questo eliminerà tutti i nomi dei partecipanti e gli indirizzi postali dalle "
"posizioni d'ordine, nonché le modifiche registrate ad essi."

#: pretix/base/shredder.py
msgid "Invoice addresses"
msgstr "Indirizzi delle fatture"

#: pretix/base/shredder.py
msgid ""
"This will remove all invoice addresses from orders, as well as logged "
"changes to them."
msgstr ""
"Questo eliminerà tutti gli indirizzi delle fatture dagli ordini, così come "
"le modifiche registrate ad essi."

#: pretix/base/shredder.py
msgid "Question answers"
msgstr "Risposte alle domande"

#: pretix/base/shredder.py
msgid ""
"This will remove all answers to questions, as well as logged changes to them."
msgstr ""
"Questo eliminerà tutte le risposte alle domande, così come le modifiche "
"registrate a loro."

#: pretix/base/shredder.py
msgid ""
"This will remove all invoice PDFs, as well as any of their text content that "
"might contain personal data from the database. Invoice numbers and totals "
"will be conserved."
msgstr ""
"Questo eliminerà tutti i PDF delle fatture, così come ogni contenuto "
"testuale che potrebbe contenere dati personali dal database. I numeri delle "
"fatture e i totali saranno conservati."

#: pretix/base/shredder.py
msgid "Cached ticket files"
msgstr "File dei biglietti memorizzati nella cache"

#: pretix/base/shredder.py
msgid "This will remove all cached ticket files. No download will be offered."
msgstr ""
"Questa operazione eliminerà tutti i file dei biglietti memorizzati nella "
"cache. Non verrà offerto alcun download."

#: pretix/base/shredder.py
msgid ""
"This will remove payment-related information. Depending on the payment "
"method, all data will be removed or personal data only. No download will be "
"offered."
msgstr ""
"Questo eliminerà le informazioni relative al pagamento. A seconda del metodo "
"di pagamento, verranno rimossi tutti i dati o solo i dati personali. Nessun "
"download sarà offerto."

#: pretix/base/templates/400.html
msgid "Bad Request"
msgstr "Richiesta Errata"

#: pretix/base/templates/400.html
msgid "We were unable to parse your request."
msgstr "Non riusciamo ad elaborare la tua richiesta."

