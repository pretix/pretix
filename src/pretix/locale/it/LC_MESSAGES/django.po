#: pretix/presale/templates/pretixpresale/event/cookies.html
#: pretix/presale/templates/pretixpresale/event/offline.html
msgid "Try again"
msgstr "Prova di nuovo"

#: pretix/base/templates/400_hostname.html
msgid "Unknown host"
